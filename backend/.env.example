# Server Environment Config
PORT=3000
NODE_ENV=production

# Database Connection (PostgreSQL)
# Synchronize MUST be false to protect existing user CSDL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_DATABASE=datthucan
DB_SYNCHRONIZE=false
DB_POOL_MAX=25
DB_SSL=false

# CORS & Allowed Origins (Web Admin / Merchant Portal)
CLIENT_ORIGIN=http://localhost:5173,https://admin.yourdomain.com

# JWT Authentication Config
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# Initial Admin Setup (Optional bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# PayOS Payment Gateway Credentials (VietQR / Chuyển khoản)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYMENT_WEBHOOK_SECRET=your_payos_checksum_key_here

# TomTom Routing API Key
TOMTOM_API_KEY=your_tomtom_api_key_here

# Network / Proxy Config (Number of trusted reverse proxy hops e.g. Nginx/Docker)
TRUST_PROXY_HOPS=1
